# Vercel project environment variables (set in the Vercel dashboard, not committed).
# All are server-side only; none are exposed to the browser.

# The deployed control-plane API base URL (your Render service URL).
FORGE_BACKEND_URL=https://forge-api-XXXX.onrender.com

# Must match the API's FORGE_AUTH_HMAC_SECRET exactly. Generate once with:
#   openssl rand -base64 48
FORGE_AUTH_HMAC_SECRET=<same-strong-secret-as-the-api>

# Identity encoded into the token the BFF mints for the API.
FORGE_DEV_SUBJECT=portal
FORGE_DEV_GROUPS=platform
