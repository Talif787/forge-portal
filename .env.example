# The Forge control-plane API base URL (server-side only; never exposed to the browser).
FORGE_BACKEND_URL=http://localhost:8080
# Must match the backend's FORGE_AUTH_HMAC_SECRET when the backend runs in hmac (dev) mode.
FORGE_AUTH_HMAC_SECRET=local-development-secret-change-me
# Identity encoded into the dev token.
FORGE_DEV_SUBJECT=portal-dev-user
FORGE_DEV_GROUPS=platform
